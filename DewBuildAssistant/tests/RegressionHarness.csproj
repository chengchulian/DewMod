    <Reference Include="System.Core" />
    <!-- Unity 的 Json.NET 使用 Mono 强名称策略；CLR 测试使用 MSBuild 自带的签名版 13.x。 -->
    <Reference Include="Newtonsoft.Json"><HintPath>$(MSBuildBinPath)\Newtonsoft.Json.dll</HintPath><Private>True</Private></Reference>
    <Compile Include="src\GameStubs.cs" />
    <Compile Include="src\BuildNeedStubs.cs" />
    <Compile Include="src\Program.cs" />
    <Compile Include="src\WorkshopStubs.cs" />
    <Compile Include="src\WorkshopUploadTests.cs" />
    <Compile Include="..\src\util\BuildAppliedAnnouncement.cs" Link="Production\BuildAppliedAnnouncement.cs" />
    <Compile Include="..\src\ui\LocalizedTextBinding.cs" Link="Production\LocalizedTextBinding.cs" />
    <Compile Include="..\src\ui\NativeSkillSprites.cs" Link="Production\NativeSkillSprites.cs" />
    <Compile Include="..\src\ui\NativeIconFit.cs" Link="Production\NativeIconFit.cs" />
    <Compile Include="..\src\util\IdentityChangeCompatibility.cs" Link="Production\IdentityChangeCompatibility.cs" />
    <Compile Include="..\src\util\BuildNeedCompatibility.cs" Link="Production\BuildNeedCompatibility.cs" />
    <Compile Include="..\src\util\RecommendationEditing.cs" Link="Production\RecommendationEditing.cs" />
