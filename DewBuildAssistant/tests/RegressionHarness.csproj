    <Compile Include="..\src\util\WorkshopBuildCodec.cs" Link="Production\WorkshopBuildCodec.cs" />
    <Compile Include="..\src\util\WorkshopGuideFilter.cs" Link="Production\WorkshopGuideFilter.cs" />
    <Compile Include="..\src\util\WorkshopLocalPages.cs" Link="Production\WorkshopLocalPages.cs" />
    <Compile Include="..\src\controller\BuildExporter.cs" Link="Production\BuildExporter.cs" />
    <Compile Include="..\src\controller\WorkshopClient.cs" Link="Production\WorkshopClient.cs" />
    <Compile Include="..\src\model\GuideData.cs" Link="Production\GuideData.cs" />
    <Compile Include="..\src\controller\BuildApplicator.cs" Link="Production\BuildApplicator.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
