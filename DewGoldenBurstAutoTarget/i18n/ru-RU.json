{
  "Header.Input": "\u0412\u0432\u043E\u0434",
  "Header.Targets": "\u0426\u0435\u043B\u0438",
  "LabelText.CastKey": "\u0413\u043E\u0440\u044F\u0447\u0430\u044F \u043A\u043B\u0430\u0432\u0438\u0448\u0430",
  "Description.CastKey": "\u041A\u043B\u0430\u0432\u0438\u0448\u0430 \u0434\u043B\u044F \u0430\u0432\u0442\u043E\u043D\u0430\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F Golden Burst \u0438\u0437 \u0441\u043B\u043E\u0442\u0430 Q.",
  "LabelText.HoldToCast": "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C \u0434\u043B\u044F \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F",
  "Description.HoldToCast": "\u0415\u0441\u043B\u0438 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u043E, \u0443\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u043A\u043B\u0430\u0432\u0438\u0448\u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435. \u0415\u0441\u043B\u0438 \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D\u043E, \u043A\u0430\u0436\u0434\u043E\u0435 \u043D\u0430\u0436\u0430\u0442\u0438\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442 \u043E\u0434\u0438\u043D \u0440\u0430\u0437.",
  "LabelText.TargetAllies": "\u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u043D\u0430 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432",
  "Description.TargetAllies": "\u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u0441\u043E\u044E\u0437\u043D\u044B\u0435 \u044E\u043D\u0438\u0442\u044B \u0438 \u0438\u0433\u0440\u043E\u043A\u043E\u0432 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435 \u0446\u0435\u043B\u0435\u0439.",
  "LabelText.RequireFriendlyTeammates": "\u041F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u043D\u0435 \u0434\u0440\u0443\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445 \u0438\u0433\u0440\u043E\u043A\u043E\u0432",
  "Description.RequireFriendlyTeammates": "\u0415\u0441\u043B\u0438 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u043E, \u0446\u0435\u043B\u0438-\u0433\u0435\u0440\u043E\u0438 \u0438\u0433\u043D\u043E\u0440\u0438\u0440\u0443\u044E\u0442\u0441\u044F, \u043A\u043E\u0433\u0434\u0430 \u043E\u043D\u0438 \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0435 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430\u043C\u0438.",
  "LabelText.TargetMonsters": "\u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u043D\u0430 \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432",
  "Description.TargetMonsters": "\u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432, \u043D\u0435 \u044F\u0432\u043B\u044F\u044E\u0449\u0438\u0445\u0441\u044F \u0431\u043E\u0441\u0441\u0430\u043C\u0438.",
  "LabelText.TargetBosses": "\u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u043D\u0430 \u0431\u043E\u0441\u0441\u043E\u0432",
  "Description.TargetBosses": "\u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u044D\u043B\u0438\u0442\u0443, \u043C\u0438\u043D\u0438-\u0431\u043E\u0441\u0441\u043E\u0432 \u0438 \u0431\u043E\u0441\u0441\u043E\u0432.",
  "LabelText.SkipDamageImmuneMonsters": "\u041F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u043D\u0435\u0443\u044F\u0437\u0432\u0438\u043C\u044B\u0445 \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432",
  "Description.SkipDamageImmuneMonsters": "\u0415\u0441\u043B\u0438 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u043E, \u043C\u043E\u043D\u0441\u0442\u0440\u044B \u0441 \u0438\u043C\u043C\u0443\u043D\u0438\u0442\u0435\u0442\u043E\u043C \u043A \u0443\u0440\u043E\u043D\u0443 \u0438\u0433\u043D\u043E\u0440\u0438\u0440\u0443\u044E\u0442\u0441\u044F.",
  "LabelText.TargetStones": "\u041F\u0440\u0438\u043C\u0435\u043D\u044F\u0442\u044C \u043D\u0430 \u043A\u0430\u043C\u043D\u0438",
  "Description.TargetStones": "\u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u0437\u043E\u043B\u043E\u0442\u043E, \u043F\u044B\u043B\u044C \u0441\u043D\u043E\u0432 \u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0435 \u0446\u0435\u043B\u0438."
}
